<Window 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Televim.Shell.Views.MainWindow"
    xmlns:vm="using:Televim.Shell.ViewModels"
    x:DataType="vm:IMainViewModel"
    Title="Televim"
    Width="800" Height="600"
    Focusable="True"
    Opened="OnOpened">

<Grid>
    <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBox
        Grid.Row="0"
        Name="InputTextBox"
        IsEnabled="{Binding IsInsertMode}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Center"
        Margin="5,0"/>

<TextBlock 
    Grid.Row="1"
    Text="{Binding Buffer}"
    HorizontalAlignment="Center"
    VerticalAlignment="Center" />
</Grid>

</Window>
