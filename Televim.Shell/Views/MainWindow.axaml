<Window 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Televim.Shell.Views.MainWindow"
    xmlns:vm="using:Televim.Shell.ViewModels"
    xmlns:conv="using:Televim.Shell.Views.Converters"
    x:DataType="vm:IMainViewModel"
    Title="Televim"
    Width="800" Height="600"
    Focusable="True"
    Opened="OnOpened">

<Window.Styles>
    <Style Selector="TextBlock.commandPrompt">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="TextBlock.commandPrompt.visible">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
</Window.Styles>

<Grid>
    <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid
        Grid.Row="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <ContentControl
            Grid.Column="0"
            Content="{Binding ChatList}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:IChatList}">
                    <ListBox
                        SelectedItem="{Binding SelectedChat}"
                        ItemsSource="{Binding Chats}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:IChat}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Text="{Binding Name}"
                                        FontWeight="Bold" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Text="{Binding LastMessage.Text}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <ContentControl 
            Grid.Column="1"
            Content="{Binding OpenChat}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:IOpenChat}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox
                            Grid.Row="0"
                            ItemsSource="{Binding Messages}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:IChatMessage}">
                                    <Grid>
                                        <TextBlock Text="{Binding Text}" /> 
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBox
                            Grid.Row="1"
                            AcceptsTab="True"
                            AcceptsReturn="True"
                            IsEnabled="{Binding CurrentInputMode, Converter={conv:InputModeToBoolConverter INSERT}}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Margin="5,0"/>
                    </Grid>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Grid>

    <Grid
        Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

    <TextBlock
        Grid.Column="0"
        Classes="commandPrompt"
        Classes.visible="{Binding CurrentInputMode, Converter={conv:InputModeToBoolConverter COMMAND}}"
        Visual.ZIndex="1"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        FontWeight="Bold"
        FontSize="14"
        Margin="5, 0, 0, 1"
        Text=":">
    </TextBlock>

    <TextBox 
        Grid.Column="0"
        IsEnabled="{Binding CurrentInputMode, Converter={conv:InputModeToBoolConverter COMMAND}}"
        AcceptsTab="True"
        Padding="9, 0, 0, 0"
        Name="CommandTextBox"
        VerticalContentAlignment="Center"
        Text="{Binding CommandText, Mode=TwoWay}"
        TextAlignment="Left"/>

    <TextBox 
        Grid.Column="1"
        IsEnabled="False"
        Text="{Binding ActionBuffer}"
        TextAlignment="Right" />
    </Grid>

</Grid>

</Window>
